#! /bin/zsh

ZSH_FOLDER=`dirname "$0"`
ROOT_FOLDER=$ZSH_FOLDER/..

source $ZSH_FOLDER/code_config
source $ZSH_FOLDER/exa_config
source $ZSH_FOLDER/prompt_config

export TERM=xterm-color
export CLICOLOR=1
export LSCOLORS=Dxfxcxdxbxegedabagacad

export EDITOR=mvim
export CC=/usr/bin/gcc

export PATH="/opt/homebrew/opt/libpq/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"
export PATH="$PATH:~/go/bin"
export LDFLAGS="-L/opt/homebrew/opt/libpq/lib"
export CPPFLAGS="-I/opt/homebrew/opt/libpq/include"
export PKG_CONFIG_PATH="/opt/homebrew/opt/libpq/lib/pkgconfig"

export DISABLE_CORS_CHECKS=1
export AWS_ENDPOINT_URL=http://localhost:4566
export LOCALSTACK_AUTH_TOKEN="ls-fAXedaTa-gIQi-5857-sIYe-gUNu8953509d"
export DEBUG=1

function claude() {
  local profiles=("GearJot" "Test Double")
  local configs=("$HOME/.claude-gearjot" "$HOME/.claude-testdouble")
  local PS3="Profile: "
  select name in "${profiles[@]}"; do
    [[ $REPLY -ge 1 && $REPLY -le ${#profiles[@]} ]] || { echo "Invalid selection"; continue; }
    CLAUDE_CONFIG_DIR="${configs[$REPLY]}" command claude "$@"
    break
  done
}

